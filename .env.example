# Copy to .env and adjust. Never commit .env — it is git-ignored.

# --- AI (optional) -----------------------------------------------------------
# Without a key the platform still runs end-to-end: the planner uses deterministic rules and
# extraction uses selectors / structured data only. With a key, Claude plans workflows,
# interprets ambiguous pages (evidence-checked) and writes report summaries.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium
LLM_EXTRACTION_FALLBACK=true
# Server-side refusal fallback (Claude API). Set false if your account/proxy rejects the beta header.
LLM_REFUSAL_FALLBACKS=true

# --- Price intelligence --------------------------------------------------------
PRICE_CHANGE_THRESHOLD=5
# Moves larger than this are stored as NEEDS_REVIEW instead of alerting as real changes.
MAX_PLAUSIBLE_CHANGE_PCT=80
SUPPORTED_CURRENCIES=USD,EUR,GBP,PKR,INR,AED,SAR,CAD,AUD,JPY,CNY,CHF,SEK,NOK,DKK,PLN,TRY,ZAR,SGD,NZD

# --- Browser -------------------------------------------------------------------
BROWSER_HEADLESS=true
BROWSER_SLOW_MO_MS=0
NAVIGATION_TIMEOUT_MS=30000
ACTION_TIMEOUT_MS=10000
# Appended to Chromium's real user agent so site owners can identify the automation.
USER_AGENT_SUFFIX=WebOpsAgent/0.1

# --- Limits & politeness -------------------------------------------------------
MAX_CONCURRENCY=2
DEFAULT_REQUEST_DELAY_SECONDS=3
MAX_RETRIES=2
MAX_PRODUCTS_PER_RUN=1000
RUN_TIMEOUT_SECONDS=3600
RESPECT_ROBOTS_TXT=true
# Propose (never auto-apply) replacements for configured selectors that stop working.
SELECTOR_HEALING=true

# --- Server --------------------------------------------------------------------
# If set, POST/PATCH API calls require header X-API-Key (enter it in Data Onboarding → API key).
API_KEY=
SCHEDULER_ENABLED=true
SCHEDULER_POLL_SECONDS=30
# Optional: POST each alert as JSON to Slack/Teams/n8n/Zapier incoming webhook.
ALERT_WEBHOOK_URL=

# --- Paths (defaults shown) ----------------------------------------------------
# DATABASE_URL=sqlite:///./data/webops.db
# WEBSITES_CONFIG=config/websites.yaml
# WORKFLOWS_CONFIG=config/workflows.yaml

# --- Website credentials (only for sites you are authorized to log in to) -------
# Referenced from config/websites.yaml as ${NAME}; values are masked in all logs.
# SUPPLIER_A_USERNAME=
# SUPPLIER_A_PASSWORD=
